# Copy to /etc/kenai-vpn/helper.env with root:root mode 0600.
# Resolve numeric IDs and public parameters during deployment preflight.
KENAI_HELPER_ALLOWED_UID=REPLACE_WITH_VPNADMIN_UID
KENAI_HELPER_SOCKET_GID=REPLACE_WITH_VPNADMIN_GROUP_GID
KENAI_HELPER_SOCKET_PATH=/run/kenai-vpn/helper.sock
KENAI_HELPER_STATE_DIRECTORY=/var/lib/kenai-vpn-helper
KENAI_HELPER_WIREGUARD_ENABLED=false
KENAI_HELPER_AMNEZIAWG_ENABLED=false

# Future optional WireGuard settings; not required for the VLESS-only deployment.
KENAI_HELPER_WIREGUARD_CONFIG=/etc/wireguard/wg0.conf
KENAI_HELPER_WIREGUARD_INTERFACE=wg0
KENAI_HELPER_WIREGUARD_NETWORK=10.66.66.0/24
KENAI_HELPER_WIREGUARD_SERVER_ADDRESS=10.66.66.1
KENAI_HELPER_WIREGUARD_LISTEN_PORT=51820
KENAI_HELPER_PUBLIC_ENDPOINT=REPLACE_WITH_RUSSIAN_INGRESS_IP_OR_NAME
# KENAI_HELPER_WIREGUARD_SERVER_PUBLIC_KEY=REPLACE_IF_ENABLED
KENAI_HELPER_WIREGUARD_DNS='["1.1.1.1","1.0.0.1"]'

# AmneziaWG 2.0 is independent from wg0 and requires awg/awg-quick on the VPS.
KENAI_HELPER_AMNEZIAWG_CONFIG=/etc/amneziawg/awg0.conf
KENAI_HELPER_AMNEZIAWG_INTERFACE=awg0
KENAI_HELPER_AMNEZIAWG_NETWORK=10.67.67.0/24
KENAI_HELPER_AMNEZIAWG_SERVER_ADDRESS=10.67.67.1
KENAI_HELPER_AMNEZIAWG_LISTEN_PORT=585
# KENAI_HELPER_AMNEZIAWG_SERVER_PUBLIC_KEY=REPLACE_IF_ENABLED
KENAI_HELPER_AMNEZIAWG_DNS='["1.1.1.1","1.0.0.1"]'
KENAI_HELPER_AMNEZIAWG_JC=7
KENAI_HELPER_AMNEZIAWG_JMIN=64
KENAI_HELPER_AMNEZIAWG_JMAX=256
KENAI_HELPER_AMNEZIAWG_S1=32
KENAI_HELPER_AMNEZIAWG_S2=32
KENAI_HELPER_AMNEZIAWG_S3=32
KENAI_HELPER_AMNEZIAWG_S4=16
KENAI_HELPER_AMNEZIAWG_H1=100000000-199999999
KENAI_HELPER_AMNEZIAWG_H2=200000000-299999999
KENAI_HELPER_AMNEZIAWG_H3=300000000-399999999
KENAI_HELPER_AMNEZIAWG_H4=400000000-499999999
# AWG 2.0 custom signature packets are optional. Set only reviewed tag expressions.
KENAI_HELPER_AMNEZIAWG_I1=''
KENAI_HELPER_AMNEZIAWG_I2=''
KENAI_HELPER_AMNEZIAWG_I3=''
KENAI_HELPER_AMNEZIAWG_I4=''
KENAI_HELPER_AMNEZIAWG_I5=''
KENAI_HELPER_AWG_BINARY=/usr/local/bin/awg
KENAI_HELPER_AWG_QUICK_BINARY=/usr/local/bin/awg-quick

KENAI_HELPER_XRAY_CONFIG=/usr/local/etc/xray/config.json
# Leave unset only when exactly one VLESS inbound listens on the configured port.
# KENAI_HELPER_XRAY_INBOUND_TAG=kenai-vless-reality
KENAI_HELPER_XRAY_PORT=443
KENAI_HELPER_XRAY_SERVER_NAME=REPLACE_WITH_EXISTING_REALITY_SERVER_NAME
KENAI_HELPER_XRAY_REALITY_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
KENAI_HELPER_XRAY_SHORT_ID=REPLACE_WITH_EXISTING_SHORT_ID
# Optional local-only Xray Stats API. Never bind this API publicly.
# KENAI_HELPER_XRAY_STATS_SERVER=127.0.0.1:10085
