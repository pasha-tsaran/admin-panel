[Unit]
Description=Collect Kenai VPN control-plane metrics
After=kenai-vpn-helper.service postgresql.service

[Service]
Type=oneshot
User=vpnadmin
Group=kenai-vpn
EnvironmentFile=/etc/kenai-vpn/web.env
ExecStart=/opt/kenai-vpn/venv/bin/kenai-console-maintenance collect-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
