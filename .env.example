KENAI_ENV=development
KENAI_DATABASE_URL=postgresql+psycopg://kenai:replace-with-a-random-password@127.0.0.1:5432/kenai
KENAI_SECRET_KEY=replace-with-at-least-32-random-characters
KENAI_ENCRYPTION_KEY=replace-with-a-fernet-key
KENAI_VPN_BACKEND=mock
KENAI_SUBSCRIPTION_PROTOCOLS=vless
KENAI_BACKUP_PROTOCOLS=vless
KENAI_MAX_SUBSCRIPTION_DEVICES=32
KENAI_HOST=127.0.0.1
KENAI_PORT=8000
KENAI_COOKIE_SECURE=false
KENAI_SESSION_TTL_MINUTES=60
KENAI_PROVISIONING_TTL_MINUTES=15
KENAI_LOGIN_MAX_ATTEMPTS=5
KENAI_LOGIN_WINDOW_MINUTES=15
KENAI_LOGIN_TOTP_REQUIRED=true
KENAI_WIREGUARD_CONNECTED_WINDOW_SECONDS=180

# Support: fill these on the server, then start kenai-support-worker.
# Use a dedicated bot. Never place its token in the desktop application.
KENAI_SUPPORT_ENABLED=false
KENAI_SUPPORT_TELEGRAM_BOT_TOKEN=
KENAI_SUPPORT_TELEGRAM_CHAT_ID=0
# Comma-separated numeric IDs of operators allowed to reply/change statuses.
KENAI_SUPPORT_TELEGRAM_ADMIN_IDS=
KENAI_NOTIFICATION_TELEGRAM_BOT_TOKEN=
KENAI_NOTIFICATION_RETRY_LIMIT=3
KENAI_METRICS_RETENTION_DAYS=30

# Existing direct VPN servers shown in the administration panel.
KENAI_PRIMARY_ADDRESS=
KENAI_PRIMARY_COUNTRY_NAME=Армения
KENAI_PRIMARY_CITY=Ереван
KENAI_NETHERLANDS_ADDRESS=
KENAI_NETHERLANDS_SERVER_NAME=
KENAI_NETHERLANDS_PUBLIC_KEY=
KENAI_NETHERLANDS_SHORT_ID=
KENAI_NETHERLANDS_AWG_PUBLIC_KEY=
KENAI_NETHERLANDS_AWG_HEADER_PROTECTION_KEY=
